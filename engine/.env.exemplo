# Copie para .env e preencha. Nunca envie o .env para o GitHub.

# Senha que o site usa para chamar o motor (gere uma longa e aleatória)
PRISMO_TOKEN=troque-por-uma-senha-longa-e-aleatoria

# Senha que o motor envia ao site no callback (pode ser igual à de cima)
PRISMO_CALLBACK_TOKEN=

# Supabase do projeto do Lovable (Configurações do projeto > API)
SUPABASE_URL=https://SEU-PROJETO.supabase.co
SUPABASE_SERVICE_ROLE_KEY=

# Opcionais
PRISMO_BUCKET_FAIXAS=stems
PRISMO_BUCKET_RESULTADOS=results
PRISMO_MAX_MB=60
PRISMO_TRABALHADORES=1
